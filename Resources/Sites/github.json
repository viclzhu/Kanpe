{
  "name": "GitHub",
  "match": ["github.com"],
  "groups": [
    {
      "title": "Site-wide",
      "shortcuts": [
        { "title": "Focus search", "keys": "/", "level": "core" },
        { "title": "Open command palette", "keys": "cmd+k", "level": "core" },
        { "title": "Show all keyboard shortcuts", "keys": "?", "level": "core" },
        { "title": "Go to notifications", "keys": "g n", "level": "extended" },
        { "title": "Go to dashboard", "keys": "g d", "level": "extended" }
      ]
    },
    {
      "title": "Repository",
      "shortcuts": [
        { "title": "Go to Code", "keys": "g c", "level": "core" },
        { "title": "Go to Issues", "keys": "g i", "level": "core" },
        { "title": "Go to Pull requests", "keys": "g p", "level": "core" },
        { "title": "Open in github.dev editor", "keys": ".", "level": "core" },
        { "title": "Go to Actions", "keys": "g a", "level": "extended" },
        { "title": "Go to Projects", "keys": "g b", "level": "extended" },
        { "title": "Go to Wiki", "keys": "g w", "level": "extended" },
        { "title": "Go to Discussions", "keys": "g g", "level": "extended" },
        { "title": "Open github.dev in a new tab", "keys": "shift+.", "level": "complete" }
      ]
    },
    {
      "title": "Code",
      "shortcuts": [
        { "title": "Find file", "keys": "t", "level": "core" },
        { "title": "Switch branch or tag", "keys": "w", "level": "extended" },
        { "title": "Jump to line", "keys": "l", "level": "extended" },
        { "title": "Permalink to this version", "keys": "y", "level": "extended" },
        { "title": "Open blame", "keys": "b", "level": "extended" }
      ]
    },
    {
      "title": "Issues & PRs",
      "shortcuts": [
        { "title": "Submit comment", "keys": "cmd+enter", "level": "core" },
        { "title": "Create issue (in Issues tab)", "keys": "c", "level": "extended" },
        { "title": "Set assignee", "keys": "a", "level": "extended" },
        { "title": "Set labels", "keys": "l", "level": "extended" },
        { "title": "Set milestone", "keys": "m", "level": "extended" },
        { "title": "Request reviewer", "keys": "q", "level": "extended" },
        { "title": "Quote selection in reply", "keys": "r", "level": "extended" },
        { "title": "Toggle write / preview", "keys": "shift+cmd+p", "level": "extended" }
      ]
    },
    {
      "title": "Issue & PR lists",
      "level": "complete",
      "shortcuts": [
        { "title": "Open selected issue", "keys": "o or enter" },
        { "title": "Focus the filter bar", "keys": "cmd+/" },
        { "title": "Filter by author", "keys": "u" },
        { "title": "Filter by label", "keys": "l" },
        { "title": "Filter by assignee", "keys": "a" },
        { "title": "Filter by milestone", "keys": "m" }
      ]
    },
    {
      "title": "PR changes",
      "level": "complete",
      "shortcuts": [
        { "title": "Open list of commits", "keys": "c" },
        { "title": "Open list of changed files", "keys": "t" },
        { "title": "Next / previous file", "keys": "j or k" },
        { "title": "Add a single review comment", "keys": "shift+cmd+enter" }
      ]
    },
    {
      "title": "Writing",
      "level": "complete",
      "shortcuts": [
        { "title": "Bold", "keys": "cmd+b" },
        { "title": "Italic", "keys": "cmd+i" },
        { "title": "Inline code", "keys": "cmd+e" },
        { "title": "Insert link", "keys": "cmd+k" }
      ]
    },
    {
      "title": "Notifications",
      "level": "complete",
      "shortcuts": [
        { "title": "Mark as done", "keys": "e" },
        { "title": "Mark as read", "keys": "shift+i" },
        { "title": "Mark as unread", "keys": "shift+u" },
        { "title": "Unsubscribe", "keys": "shift+m" }
      ]
    }
  ]
}
