{
  "name": "GitHub",
  "updated": "2026-11-11",
  "match": [
    "github.com"
  ],
  "pages": [
    {
      "id": "repository",
      "name": "Repository",
      "paths": [
        "/*/*/**",
        "!/{settings,notifications,orgs,organizations,marketplace,explore,topics,trending,collections,sponsors,features,enterprise,pricing,about,login,signup,new,codespaces,search,issues,pulls,dashboard,apps,users,stars,account,security,copilot}/**"
      ]
    },
    {
      "id": "code",
      "name": "Code",
      "paths": [
        "/*/*",
        "/*/*/tree/**",
        "/*/*/blob/**",
        "/*/*/blame/**",
        "!/{settings,notifications,orgs,organizations,marketplace,explore,topics,trending,collections,sponsors,features,enterprise,pricing,about,login,signup,new,codespaces,search,issues,pulls,dashboard,apps,users,stars,account,security,copilot}/**"
      ]
    },
    {
      "id": "issues",
      "name": "Issues",
      "paths": [
        "/*/*/issues",
        "/issues"
      ]
    },
    {
      "id": "issue",
      "name": "Issue",
      "paths": [
        "/*/*/issues/*"
      ]
    },
    {
      "id": "pull-requests",
      "name": "Pull requests",
      "paths": [
        "/*/*/pulls",
        "/pulls"
      ]
    },
    {
      "id": "pull-request",
      "name": "Pull request",
      "paths": [
        "/*/*/pull/*/**"
      ]
    },
    {
      "id": "notifications",
      "name": "Notifications",
      "paths": [
        "/notifications/**"
      ]
    }
  ],
  "groups": [
    {
      "id": "site-wide",
      "title": "Site-wide",
      "shortcuts": [
        {
          "id": "site-wide.focus-search",
          "title": "Focus search",
          "keys": "/",
          "level": "core"
        },
        {
          "id": "site-wide.open-command-palette",
          "title": "Open command palette",
          "keys": "cmd+k",
          "level": "core"
        },
        {
          "id": "site-wide.show-all-keyboard-shortcuts",
          "title": "Show all keyboard shortcuts",
          "keys": "?",
          "level": "core"
        },
        {
          "id": "site-wide.go-to-notifications",
          "title": "Go to notifications",
          "keys": "g n",
          "level": "extended"
        },
        {
          "id": "site-wide.go-to-dashboard",
          "title": "Go to dashboard",
          "keys": "g d",
          "level": "extended"
        }
      ]
    },
