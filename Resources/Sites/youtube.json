{
  "name": "YouTube",
  "match": ["youtube.com", "m.youtube.com"],
  "groups": [
    {
      "title": "Playback",
      "shortcuts": [
        { "title": "Play / pause", "keys": "k", "level": "core" },
        { "title": "Back 10 seconds", "keys": "j", "level": "core" },
        { "title": "Forward 10 seconds", "keys": "l", "level": "core" },
        { "title": "Mute", "keys": "m", "level": "core" },
        { "title": "Back / forward 5 seconds", "keys": "left or right", "level": "extended" },
        { "title": "Volume up / down", "keys": "up or down", "level": "extended" },
        { "title": "Next video", "keys": "shift+n", "level": "extended" },
        { "title": "Previous video (playlist)", "keys": "shift+p", "level": "extended" },
        { "title": "Seek to 0–90%", "keys": "0-9", "level": "complete" },
        { "title": "Previous / next frame (paused)", "keys": ", or .", "level": "complete" },
        { "title": "Slower / faster", "keys": "< or >", "level": "complete" }
      ]
    },
    {
      "title": "View",
      "shortcuts": [
        { "title": "Full screen", "keys": "f", "level": "core" },
        { "title": "Captions on / off", "keys": "c", "level": "core" },
        { "title": "Theater mode", "keys": "t", "level": "extended" },
        { "title": "Miniplayer", "keys": "i", "level": "extended" },
        { "title": "Search", "keys": "/", "level": "extended" },
        { "title": "Show keyboard shortcuts", "keys": "?", "level": "complete" }
      ]
    }
  ]
}
